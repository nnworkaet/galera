{
  "language": "ru",
  "telegram": {
    "allowedUsers": [123456789]
  },
  "processes": {
    "ttlMinutes": 30,
    "maxConcurrent": 5,
    "claudePath": "claude",
    "defaultFlags": ["--dangerously-skip-permissions"],
    "timeoutMinutes": 20
  },
  "compaction": {
    "reserveTokens": 100000,
    "keepRecentTokens": 50000,
    "enabled": true
  },
  "memory": {
    "revisionIntervalMinutes": 60,
    "maxFileLines": 200,
    "deduplication": true,
    "enabled": true
  },
  "projectsRoot": "/opt/galera-projects",
  "templatesDir": "./templates",
  "whisper": {
    "enabled": false,
    "url": "http://localhost:9000/asr",
    "language": "ru"
  },
  "multiAgent": {
    "groupChatId": 0,
    "generalTopicId": 0,
    "maxChainLength": 5,
    "agentCooldownSec": 5,
    "maxMessagesPerTurn": 3,
    "tokenTimeoutSec": 1800
  }
}
